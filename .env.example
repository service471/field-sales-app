NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sheets API service account. Share the sheet with the service account email.
# On Vercel, paste the private key with \n for line breaks.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Optional tab name. The first sheet is used when this is empty.
GOOGLE_SHEET_TAB=
